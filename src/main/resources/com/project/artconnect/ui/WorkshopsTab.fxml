<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.WorkshopController">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <!-- SEARCH -->
    <HBox spacing="10.0">
        <TextField fx:id="searchField" promptText="Search workshops..." HBox.hgrow="ALWAYS"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Reset" onAction="#handleReset"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="workshopTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="180"/>
            <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="140"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="160"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
            <TableColumn fx:id="levelColumn" text="Level" prefWidth="100"/>

            <TableColumn fx:id="durationColumn" text="Duration" prefWidth="100"/>
            <TableColumn fx:id="maxParticipantsColumn" text="Max" prefWidth="80"/>
            <TableColumn fx:id="locationColumn" text="Location" prefWidth="140"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="220"/>
        </columns>
    </TableView>

    <!-- DETAILS -->
    <Label text="Workshop Details"/>

    <GridPane hgap="10.0" vgap="6.0">
        <Label text="Instructor:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="instructorDetailsLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Duration:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="durationLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Max Participants:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="maxParticipantsLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Location:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="locationLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="descriptionLabel" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- BOOKING -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="memberField" promptText="Member name" HBox.hgrow="ALWAYS"/>
        <Button text="Book Workshop" onAction="#handleBooking"/>
    </HBox>
</VBox>