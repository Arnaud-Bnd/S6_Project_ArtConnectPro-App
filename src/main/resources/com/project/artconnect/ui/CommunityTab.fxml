<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.CommunityController">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <!-- SEARCH -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search members..." HBox.hgrow="ALWAYS"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Reset" onAction="#handleReset"/>
    </HBox>

    <!-- FORM -->
    <GridPane hgap="10.0" vgap="10.0">
        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Birth Year:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="birthYearField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="City:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="cityField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Membership:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="membershipTypeField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- TABLE -->
    <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
            <TableColumn fx:id="birthYearColumn" text="Birth Year" prefWidth="100"/>
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="140"/>
            <TableColumn fx:id="cityColumn" text="City" prefWidth="140"/>
            <TableColumn fx:id="membershipTypeColumn" text="Membership" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>