<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtworkController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- SEARCH -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search artworks..." HBox.hgrow="ALWAYS"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Reset" onAction="#handleReset"/>
    </HBox>

    <!-- FORM -->
    <GridPane hgap="10" vgap="10">

        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false"/>

        <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Year:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="creationYearField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Type:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="typeField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Medium:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="mediumField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Dimensions:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="dimensionsField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Price:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Status:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <ComboBox fx:id="statusCombo" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

        <Label text="Artist:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="artistField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
        <TextArea fx:id="descriptionField" prefRowCount="2" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
    </GridPane>

    <!-- BUTTONS -->
    <HBox spacing="10">
        <Button text="Add" onAction="#handleAdd"/>
        <Button text="Update" onAction="#handleUpdate"/>
        <Button text="Delete" onAction="#handleDelete"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title"/>
            <TableColumn fx:id="artistColumn" text="Artist"/>
            <TableColumn fx:id="yearColumn" text="Year"/>
            <TableColumn fx:id="typeColumn" text="Type"/>
            <TableColumn fx:id="mediumColumn" text="Medium"/>
            <TableColumn fx:id="dimensionsColumn" text="Dimensions"/>
            <TableColumn fx:id="priceColumn" text="Price"/>
            <TableColumn fx:id="statusColumn" text="Status"/>
            <TableColumn fx:id="descriptionColumn" text="Description"/>
        </columns>
    </TableView>
</VBox>